	local row = novo("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = C.Linha,
		BorderSizePixel = 0,
	}, lista)

	local botao = novo("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	novo("TextLabel", {
		Text = item.nome,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = C.Texto,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -34, 1, 0),
	}, botao)

	local marca = novo("TextLabel", {
		Text = "●",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = C.Verde,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -11, 0.5, 0),
		Size = UDim2.new(0, 14, 1, 0),
		Visible = false,
	}, botao)

	botao.MouseEnter:Connect(function() row.BackgroundColor3 = C.LinhaHov end)
	botao.MouseLeave:Connect(function() row.BackgroundColor3 = C.Linha end)

	botao.MouseButton1Click:Connect(function()
		local ok, err = spawnar(item)
		if ok then
			avisar("Pegou: " .. item.nome, true)
			task.delay(0.7, function() marca.Visible = tenho(item.nome) end)
		else
			avisar("Falhou: " .. tostring(err), false)
		end
	end)

	table.insert(linhas, { row = row, nome = item.nome:lower(), item = item })
end

contador.Text = ("%d ferramentas"):format(#TOOLS)

busca:GetPropertyChangedSignal("Text"):Connect(function()
	local termo = busca.Text:lower()
	local n = 0
	for _, l in ipairs(linhas) do
		local bate = termo == "" or l.nome:find(termo, 1, true) ~= nil
		l.row.Visible = bate
		if bate then n = n + 1 end
	end
	contador.Text = termo == "" and ("%d ferramentas"):format(#TOOLS) or ("%d resultado(s)"):format(n)
end)

task.spawn(function()
	while gui.Parent do
		for _, l in ipairs(linhas) do
			local b = l.row:FindFirstChildOfClass("TextButton")
			if b then
				for _, c in ipairs(b:GetChildren()) do
					if c:IsA("TextLabel") and c.Text == "●" then c.Visible = tenho(l.item.nome) end
				end
			end
		end
		task.wait(1.5)
	end
end)

-- ===================== ARRASTAR / FECHAR =====================
local arrastando, inicio, posIni = false, nil, nil
barra.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		arrastando, inicio, posIni = true, input.Position, painel.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then arrastando = false end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - inicio
		painel.Position = UDim2.new(posIni.X.Scale, posIni.X.Offset + d.X, posIni.Y.Scale, posIni.Y.Offset + d.Y)
	end
end)

