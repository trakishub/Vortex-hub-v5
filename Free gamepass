-- ===================== REMOTES =====================
local function achar(pai, chaves)
	if not pai then return nil end
	for _, c in ipairs(chaves) do
		local o = pai:FindFirstChild(c)
		if o then return o end
	end
	for _, o in ipairs(pai:GetDescendants()) do
		for _, c in ipairs(chaves) do
			if o.Name == c then return o end
		end
	end
	return nil
end

local PICK = achar(RS:FindFirstChild("RE"), { "1Too1l", "1Tool", "Tool" })
local GUN  = achar(RS:FindFirstChild("Remotes"), { "GunEquip" })

-- ===================== LISTA =====================
local FALLBACK = {
	"Apple","Axe","Banana","Basketball","BBQTool","Bomb","Book","Boombox","BottledWater","Brush",
	"Candle","CandyCane","ChipsRed","ChocolateBar","Coke","Couch","Crystal","Donut","EggLauncher",
	"FireHose","Firework","FishingRod","Football","Glider","GlockBrown","Hammer","Hoverboard",
	"HotDog","Icecream","Megaphone","Money","Newspaper","PaintRoller","Phone","Pizza","Popcorn",
	"Present","Shotgun","SignRed","Snowball","SoccerBall","SprayCan","Toothbrush","Trophy","Vacuum",
	"Waffle","WaterBalloon","WateringCan","Weights","Wrench","YogaMat",
}

local function puxarLista()
	local lista, visto = {}, {}

	local mod = RS:FindFirstChild("Modules")
	mod = mod and mod:FindFirstChild("Shared")
	mod = mod and mod:FindFirstChild("DB")
	mod = mod and mod:FindFirstChild("Tools")
	mod = mod and mod:FindFirstChild("ToolsConfig")

	if mod and mod:IsA("ModuleScript") then
		local ok, cfg = pcall(require, mod)
		if ok and type(cfg) == "table" then
			local dados = cfg.cache or cfg
			for k, v in pairs(dados) do
				if type(v) == "table" and v.IsCategory ~= true then
					local nome = (type(v.Name) == "string" and v.Name) or (type(k) == "string" and k)
					if nome and nome ~= "" and nome ~= "ClearTools" and not visto[nome] then
						visto[nome] = true
						table.insert(lista, { nome = nome, gun = type(v.GunSkin) == "string" and v.GunSkin or nil })
					end
				end
			end
		end
	end

	if #lista == 0 then
		for _, n in ipairs(FALLBACK) do
			if not visto[n] then visto[n] = true; table.insert(lista, { nome = n }) end
		end
	end

	table.sort(lista, function(a, b) return a.nome:lower() < b.nome:lower() end)
	return lista
end

-- ===================== AÇÕES =====================
local function tenho(nome)
	local bp = LP:FindFirstChildOfClass("Backpack")
	local ch = LP.Character
	return (bp and bp:FindFirstChild(nome)) ~= nil or (ch and ch:FindFirstChild(nome)) ~= nil
end

local function spawnar(item)
	if item.gun and GUN then
		pcall(function() GUN:InvokeServer(item.gun, item.nome) end)
	end
	if not PICK then return false, "remote RE['1Too1l'] nao encontrado" end
	local ok, err = pcall(function() PICK:InvokeServer("PickingTools", item.nome) end)
	return ok, err
end

